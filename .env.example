# Copy to .env for docker compose overrides. Never commit real secrets.
INTERNAL_API_KEY=dev-internal-key-change-me
BOOTSTRAP_ADMIN_PASSWORD=Admin12345!

# Production-only settings (per service, via AWS Secrets Manager / SSM):
# JWKS_URL=https://cognito-idp.ap-southeast-1.amazonaws.com/<pool-id>/.well-known/jwks.json
# JWT_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/<pool-id>
# JWT_AUDIENCE=            # empty for Cognito access tokens
# BANK_ENCRYPTION_KEY=     # Fernet key (partner service)
# WEBHOOK_SECRET=          # payment gateway (payment service)
# LEGACY_MODE=http
# LEGACY_BASE_URL=https://<existing-php-system>
# LEGACY_API_KEY=
# LEGACY_WEBHOOK_SECRET=
# OTP_DEBUG_RETURN=false
# ENABLE_MOCK_GATEWAY=false
